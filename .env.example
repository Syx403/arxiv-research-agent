# DeepSeek is required for discovery and reading. On macOS, the named ARA
# Keychain item configured by scripts/configure_deepseek_key.py is also supported.
DEEPSEEK_API_KEY=
# OpenAI embeddings and Cohere Trial reranking are needed for full-text reading.
OPENAI_API_KEY=
COHERE_API_KEY=

# Optional legacy provider; not used by the default Flash routes.
OPENROUTER_API_KEY=

# Optional LangSmith export; the local browser/CLI keep tracing local.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arxiv-research-agent
LANGSMITH_TRACING=false

# Postgres (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=arxiv_agent
POSTGRES_USER=arxiv_agent
POSTGRES_PASSWORD=arxiv_agent_dev

# Optional OpenRouter app metadata (recommended in their docs)
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=arxiv-research-agent

# App
LOG_LEVEL=INFO

# Local UI research policy; each turn snapshots its own limits.
ARA_DISCOVERY_TIMEOUT_S=90
ARA_DISCOVERY_MAX_PAPERS=3
