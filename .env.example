# Model providers (DESIGN §6.1). Cohere is used for reranking from M1 on.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=

# LangSmith tracing; v2 sends traces to the project ARA_LANGSMITH_PROJECT (default ara-v2).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional overrides (defaults shown).
# ARA_DATABASE_URL=postgresql://ara:ara@127.0.0.1:5434/ara
# ARA_LANGSMITH_PROJECT=ara-v2
# ARA_GLOBAL_CAP_USD=10
# ARA_TURN_CAP_USD=0.05
